<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FrontCraft: third-party licences</title>
<style>
  body { margin: 0 auto; max-width: 860px; padding: 24px 16px; background: #10140f; color: #a9b08f; font: 13px/1.5 ui-monospace, Menlo, Consolas, monospace; }
  h1, h2, h3 { color: #d8dccc; font-weight: 600; }
  h1 { letter-spacing: 0.2em; font-size: 20px; }
  a { color: #a9b08f; }
  ul { padding-left: 20px; }
  pre { white-space: pre-wrap; background: #181d16; padding: 12px; border: 1px solid #262c20; }
  .licence { margin-top: 32px; }
</style>
</head>
<body>
<h1>FRONTCRAFT</h1>
<p>FrontCraft is licensed under the MIT licence or the Apache License 2.0, at your option (LICENSE-MIT and
LICENSE-APACHE). It is built from the open-source crates below, under these licences.</p>
<h2>Licences used</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<div class="licence">
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul>
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</div>
{{/each}}
</body>
</html>
